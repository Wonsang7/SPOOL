<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.scijava</groupId>
        <artifactId>pom-scijava</artifactId>
        <version>40.0.0</version>
        <relativePath />
    </parent>

    <groupId>org.spool</groupId>
    <artifactId>spool_fiji</artifactId>
    <version>0.2.1</version>

    <name>SPOOL for Fiji</name>
    <description>
        Photon-efficient quantitative FLIM reconstruction: training-free
        Poisson inverse with an explicit PSF forward operator (SPOOL).
    </description>
    <url>https://github.com/Wonsang7/SPOOL</url>
    <inceptionYear>2026</inceptionYear>

    <organization>
        <name>Wellman Center for Photomedicine, MGH</name>
        <url>https://wellman.massgeneral.org/</url>
    </organization>

    <licenses>
        <license>
            <name>MIT</name>
            <url>https://opensource.org/licenses/MIT</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>Wonsang7</id>
            <name>Wonsang Hwang</name>
            <roles>
                <role>developer</role>
            </roles>
        </developer>
    </developers>

    <contributors>
        <contributor>
            <name>SPOOL contributors</name>
            <roles>
                <role>developer</role>
            </roles>
        </contributor>
    </contributors>

    <mailingLists>
        <mailingList>
            <name>SPOOL project discussions</name>
            <archive>https://github.com/Wonsang7/SPOOL/issues</archive>
        </mailingList>
    </mailingLists>

    <scm>
        <connection>scm:git:https://github.com/Wonsang7/SPOOL.git</connection>
        <developerConnection>scm:git:https://github.com/Wonsang7/SPOOL.git</developerConnection>
        <url>https://github.com/Wonsang7/SPOOL</url>
        <tag>HEAD</tag>
    </scm>

    <issueManagement>
        <system>GitHub Issues</system>
        <url>https://github.com/Wonsang7/SPOOL/issues</url>
    </issueManagement>

    <ciManagement>
        <system>GitHub Actions</system>
        <url>https://github.com/Wonsang7/SPOOL/actions</url>
    </ciManagement>

    <properties>
        <spool.build.id>unknown</spool.build.id>
        <package-name>org.spool</package-name>
        <license.licenseName>mit</license.licenseName>
        <license.copyrightOwners>Wonsang Hwang</license.copyrightOwners>
    </properties>

    <dependencies>
        <dependency>
            <groupId>net.imagej</groupId>
            <artifactId>ij</artifactId>
        </dependency>
        <dependency>
            <groupId>org.scijava</groupId>
            <artifactId>scijava-common</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-math3</artifactId>
        </dependency>
        <dependency>
            <groupId>org.jocl</groupId>
            <artifactId>jocl</artifactId>
            <version>2.0.6</version>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
            </resource>
            <resource>
                <directory>src/main/build-metadata</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifestEntries>
                            <Implementation-Version>${project.version}</Implementation-Version>
                            <SPOOL-Build-Id>${spool.build.id}</SPOOL-Build-Id>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <executions>
                    <execution>
                        <goals><goal>integration-test</goal><goal>verify</goal></goals>
                    </execution>
                </executions>
                <configuration>
                    <systemPropertyVariables>
                        <spool.test.jar>${project.build.directory}/${project.build.finalName}.jar</spool.test.jar>
                        <spool.test.version>${project.version}</spool.test.version>
                        <spool.test.build.id>${spool.build.id}</spool.test.build.id>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <!-- Bundle only the OpenCL bridge, including its native
                                 libraries. ImageJ/SciJava remain provided by Fiji.
                                 Do not relocate JOCL: JNI uses these class names. -->
                            <artifactSet>
                                <includes><include>org.jocl:jocl</include></includes>
                            </artifactSet>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <repositories>
        <repository>
            <id>scijava.public</id>
            <url>https://maven.scijava.org/content/groups/public</url>
        </repository>
    </repositories>
</project>
